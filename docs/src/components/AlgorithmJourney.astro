---
import { JourneyPlayer } from "./sequence-flow/journey-player"
import { parseJourneyMarkdown } from "./sequence-flow/journey-markdown"
import { parseSequenceDiagram } from "./sequence-flow/parser"
import { sourceUrl } from "../lib/site"

interface Props { markdown: string }
const { markdown } = Astro.props
const journey = parseJourneyMarkdown(markdown)
const sources = [...markdown.matchAll(/<!--\s*@source:\s*(.+?)\s*-->/g)].map((match) => match[1])

const fieldNames = ["WHAT GOES IN", "WHAT HAPPENS", "WHAT COMES OUT", "INVARIANT"]
const slides = journey.slides.map((slide) => {
  const fields = Object.fromEntries((slide.caption ?? "").split("\n").map((line) => {
    const at = line.indexOf(":")
    return at < 0 ? ["", ""] : [line.slice(0, at).trim(), line.slice(at + 1).trim()]
  }).filter(([key]) => fieldNames.includes(key)))
  const model = parseSequenceDiagram(slide.chart)
  const labels = new Map(model.participants.map((participant) => [participant.id, participant.label]))
  const events = model.events.flatMap((event) => {
    if (event.kind === "message") return [`${labels.get(event.from) ?? event.from} → ${labels.get(event.to) ?? event.to}: ${event.text}`]
    if (event.kind === "note") return [`Note: ${event.text}`]
    return []
  })
  return { ...slide, fields, events }
})
---

<section class="journey" aria-label={journey.title ?? "Algorithm journey"}>
  <div class="interactive-journey">
    <JourneyPlayer client:visible slides={journey.slides} autoPlay={false} height={460} />
  </div>

  <section class="journey-transcript" aria-label="Static journey">
    <h2>Readable journey</h2>
    {slides.map((slide, index) => (
      <article>
        <span class="eyebrow">Step {index + 1}</span>
        <h3>{slide.title}</h3>
        <dl>
          {fieldNames.map((name) => slide.fields[name] ? <><dt>{name.toLowerCase()}</dt><dd>{slide.fields[name]}</dd></> : null)}
        </dl>
        <ol>{slide.events.map((event) => <li>{event}</li>)}</ol>
      </article>
    ))}
  </section>

  {sources.length > 0 && (
    <footer class="journey-sources">
      <strong>Source</strong>
      {sources.map((source) => <a href={sourceUrl(source)}>{source}</a>)}
    </footer>
  )}
</section>

<style>
  .journey { max-width: 48rem; margin-top: 2rem; }
  .interactive-journey { border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .journey-transcript { margin-top: 3rem; }
  .journey-transcript > h2 { font-size: 1rem; }
  .journey-transcript article { border-top: 1px solid var(--border); padding: 1.2rem 0; }
  .journey-transcript h3 { margin: 0.2rem 0 0.8rem; }
  .journey-transcript dl { display: grid; grid-template-columns: 8rem 1fr; gap: 0.35rem 1rem; margin: 0; }
  .journey-transcript dt { color: var(--muted-foreground); font-size: 0.7rem; text-transform: uppercase; }
  .journey-transcript dd { margin: 0; }
  .journey-transcript ol { margin: 1rem 0 0; padding-left: 1.3rem; }
  .journey-sources { display: grid; gap: 0.3rem; border-top: 1px solid var(--border); padding-top: 1rem; font-size: 0.75rem; }
  @media (max-width: 560px) { .journey-transcript dl { grid-template-columns: 1fr; } }
</style>
